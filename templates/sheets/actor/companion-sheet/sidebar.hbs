<aside class="dsp-sidebar">
  <button type="button" class="sidebar-toggle" data-action="toggleSidebar">
    <i class="fa-solid fa-angles-left" inert></i>
  </button>

  <div class="sidebar-content">
    <section class="sidebar-section">
      <div class="sidebar-section-title">{{localize "DRAW_STEEL.SHEET.Resources"}}</div>

      <div class="sidebar-resource">
        <div class="sidebar-resource-header">
          <span><i class="fa-solid fa-heart" inert></i> {{systemFields.stamina.label}}</span>
        </div>
        {{#if isPlay}}
        <div class="stam-bar-wrap" style="--stam-current: {{system.stamina.value}}; --stam-max: {{system.stamina.max}}; --stam-temp: {{system.stamina.temporary}};">
          <div class="stam-bar-track">
            <div class="stam-bar-fill"></div>
            {{#if system.stamina.temporary}}
            <div class="stam-bar-temp"></div>
            {{/if}}
          </div>
          <div class="stam-bar-text">
            <span class="stam-val">{{system.stamina.value}}</span>
            <span class="stam-sep">/</span>
            <span class="stam-max-text">{{system.stamina.max}}</span>
            {{#if system.stamina.temporary}}
            <span class="stam-temp-text">(+{{system.stamina.temporary}})</span>
            {{/if}}
          </div>
        </div>
        <div class="sidebar-resource-fields">
          <div class="sidebar-field">
            <label>{{localize "DRAW_STEEL.Actor.base.FIELDS.stamina.value.label"}}</label>
            <input type="number" name="system.stamina.value" value="{{system.stamina.value}}">
          </div>
          <div class="sidebar-field">
            <label>Temp</label>
            <input type="number" name="system.stamina.temporary" value="{{system.stamina.temporary}}">
          </div>
          <div class="sidebar-field">
            <label>{{localize "DRAW_STEEL.Actor.base.FIELDS.stamina.max.label"}}</label>
            <span class="sidebar-static">{{system.stamina.max}}</span>
          </div>
        </div>
        {{else}}
        <div class="sidebar-resource-fields">
          <div class="sidebar-field">
            <label>{{localize "DRAW_STEEL.Actor.base.FIELDS.stamina.max.label"}}</label>
            {{formInput systemFields.stamina.fields.max value=systemSource.stamina.max dataset=datasets.isSource}}
          </div>
        </div>
        {{/if}}
      </div>

      {{!-- Recoveries belong to the companion's master; the companion only spends them. --}}
      <div class="sidebar-resource">
        <div class="sidebar-resource-header">
          {{#if (and isPlay editable master)}}
          <button type="button" data-action="spendRecovery" data-tooltip="{{localize "DRAW_STEEL.Actor.companion.SpendRecovery.tooltip" name=master.name}}">
            <i class="fa-solid fa-heart-pulse" inert></i> {{localize "DRAW_STEEL.Actor.base.FIELDS.recoveries.label"}}
          </button>
          {{else}}
          <span><i class="fa-solid fa-heart-pulse" inert></i> {{localize "DRAW_STEEL.Actor.base.FIELDS.recoveries.label"}}</span>
          {{/if}}
        </div>
        <div class="sidebar-resource-fields">
          <div class="sidebar-field">
            <label>{{localize "DRAW_STEEL.Actor.base.FIELDS.recoveries.value.label"}}</label>
            <span class="sidebar-static">{{ifThen master recoveries.value "—"}}</span>
          </div>
          <div class="sidebar-field">
            <label>{{localize "DRAW_STEEL.Actor.base.FIELDS.recoveries.max.label"}}</label>
            <span class="sidebar-static">{{ifThen master recoveries.max "—"}}</span>
          </div>
          <div class="sidebar-field">
            <label>Value</label>
            <span class="sidebar-static">{{ifThen master recoveries.recoveryValue "—"}}</span>
          </div>
        </div>
      </div>

      <div class="sidebar-resource">
        <div class="sidebar-resource-header">
          {{#if (and isPlay owner)}}
          <button type="button" data-action="freeStrike">
            <i class="fa-solid fa-burst" inert></i> {{systemFields.companion.fields.freeStrike.label}}
          </button>
          {{else}}
          <span><i class="fa-solid fa-burst" inert></i> {{systemFields.companion.fields.freeStrike.label}}</span>
          {{/if}}
        </div>
        {{#if isPlay}}
        <div class="sidebar-resource-fields">
          <div class="sidebar-field">
            <span class="sidebar-static">{{system.freeStrike.value}}{{#if freeStrikeType}} <span class="free-strike-type">{{freeStrikeType}}</span>{{/if}}</span>
          </div>
        </div>
        {{else}}
        <div class="sidebar-resource-fields">
          <div class="sidebar-field sidebar-field-wide">
            {{formInput systemFields.companion.fields.freeStrike value=systemSource.companion.freeStrike dataset=datasets.isSource}}
          </div>
        </div>
        {{/if}}
      </div>

      {{#if (and isPlay master)}}
      {{!-- The master's heroic resource and surges, read-only (the companion spends them through its abilities). --}}
      <div class="sidebar-resource companion-master-resources">
        <div class="sidebar-resource-header">
          <span><i class="fa-solid fa-user-shield" inert></i> {{master.name}}</span>
        </div>
        <div class="sidebar-resource-fields">
          {{#if master.primary}}
          <div class="sidebar-field">
            <label>{{master.primary.label}}</label>
            <span class="sidebar-static">{{master.primary.value}}</span>
          </div>
          {{/if}}
          <div class="sidebar-field">
            <label>{{heroFields.surges.label}}</label>
            <span class="sidebar-static">{{master.surges}}</span>
          </div>
          {{#if (and master.showEpic master.epic)}}
          <div class="sidebar-field">
            <label>{{master.epic.label}}</label>
            <span class="sidebar-static">{{master.epic.value}}</span>
          </div>
          {{/if}}
        </div>
      </div>
      {{/if}}
    </section>

    <section class="sidebar-section">
      <div class="sidebar-section-title">Combat & Movement</div>

      {{#if isPlay}}
      <div class="sidebar-stat-grid">
        <div class="sidebar-stat-badge">
          <span class="stat-val">{{system.combat.size}}</span>
          <span class="stat-lbl">Size</span>
        </div>
        <div class="sidebar-stat-badge">
          <span class="stat-val">{{system.combat.stability}}</span>
          <span class="stat-lbl">Stability</span>
        </div>
        <div class="sidebar-stat-badge">
          <span class="stat-val">{{system.movement.value}}</span>
          <span class="stat-lbl">{{movement.list}}</span>
        </div>
        <div class="sidebar-stat-badge">
          <span class="stat-val">{{system.movement.disengage}}</span>
          <span class="stat-lbl">Disengage</span>
        </div>
      </div>
      {{else}}
      <div class="sidebar-edit-section">
        {{> "systems/draw-steel/templates/sheets/actor/shared/partials/stats/combat.hbs"}}
        {{> "systems/draw-steel/templates/sheets/actor/shared/partials/stats/movement.hbs"}}
      </div>
      {{/if}}
    </section>

    <section class="sidebar-section">
      {{#if isPlay}}
      <div class="sidebar-tag-section">
        <div class="sidebar-tag-header"><i class="fa-solid fa-shield-heart" inert></i> {{systemFields.damage.fields.immunities.label}}</div>
        <div class="sidebar-tags" data-tag-type="immunities">
          {{#if damageIW.immunities}}
          {{{damageIW.immunities}}}
          {{else}}
          <span class="sidebar-tag sidebar-tag-none">None</span>
          {{/if}}
        </div>
      </div>
      <div class="sidebar-tag-section">
        <div class="sidebar-tag-header"><i class="fa-solid fa-heart-crack" inert></i> {{systemFields.damage.fields.weaknesses.label}}</div>
        <div class="sidebar-tags" data-tag-type="weaknesses">
          {{#if damageIW.weaknesses}}
          {{{damageIW.weaknesses}}}
          {{else}}
          <span class="sidebar-tag sidebar-tag-none">None</span>
          {{/if}}
        </div>
      </div>
      {{else}}
      <div class="sidebar-edit-section">
        {{> "systems/draw-steel/templates/sheets/actor/shared/partials/stats/immunities-weaknesses.hbs"}}
      </div>
      {{/if}}
    </section>

    <section class="sidebar-section">
      <div class="sidebar-tag-section">
        <div class="sidebar-tag-header"><i class="fa-solid fa-graduation-cap" inert></i> {{systemFields.companion.fields.skills.label}}</div>
        <div class="sidebar-tags sidebar-skills" data-tag-type="skills">
          {{#if skillsList}}
          {{skillsList}}
          {{else}}
          <span class="sidebar-tag sidebar-tag-none">None</span>
          {{/if}}
        </div>
      </div>
    </section>
  </div>
</aside>
